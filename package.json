{
  "name": "credit-strategy-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Credit card portfolio analytics: PD scorecard, risk-reward, credit limit and APR strategy simulation",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:pg-rest": "tsx scripts/local-rest.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
